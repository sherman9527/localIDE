        <mxCell id="l6" value="60d" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEEF4;strokeColor=#B8547D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="176" width="80" height="40" as="geometry" /></mxCell>
