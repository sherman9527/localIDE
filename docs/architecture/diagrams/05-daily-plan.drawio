        <mxCell id="el5" style="html=1;strokeColor=#B8547D;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="l5" target="l6"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="rules" value="&lt;b&gt;升降档规则&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;· &lt;b&gt;pass 且上次也 pass&lt;/b&gt; 才升一档（reps+1）—— 少一次&quot;侥幸做对&quot;的运气。&lt;br&gt;· &lt;b&gt;fail&lt;/b&gt; → reps 归 0，明天再来（due = today + 1）。&lt;br&gt;· &lt;b&gt;不在册且这次做对&lt;/b&gt; → 不入本。复习只服务&quot;错过的题&quot;。&lt;br&gt;· 到顶 60d 之后仍按最后一档继续排，不做&quot;毕业&quot;—— 少一个状态就少一处漂移。&lt;br&gt;· 完整 SM-2 要 0~5 的回忆质量评分，本系统只有 pass/fail 与用时，所以取二值退化。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8547D;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="240" width="560" height="146" as="geometry" />
        </mxCell>

        <mxCell id="xpTitle" value="XP 与连击（全部从 attempts 推导，不建第二张&quot;日表&quot;）" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="580" y="404" width="560" height="22" as="geometry" />
        </mxCell>
        <mxCell id="xp" value="&lt;font style=&quot;font-size:11px&quot;&gt;· pass 15 / fail 2 / error 0；主观题 XP = round(score / maxScore × 20)，&amp;ge; 60% 记 pass。&lt;br&gt;· 做完当日套餐幂等 +10（只在 POST 之后结算，GET 不写库）。&lt;br&gt;· &lt;b&gt;每题只算历史上最好那次&lt;/b&gt;（同分取更早）—— 所以&quot;本周 XP&quot;不可能大于&quot;累计 XP&quot;。&lt;br&gt;· 续签门槛 20 XP：只答 1 题不足以打卡，避免&quot;打开一下就算练了&quot;。&lt;br&gt;· 青铜 0 / 白银 150 / 黄金 450 / 铂金 1000 / 钻石 2000。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5F1;strokeColor=#1F9E7E;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="432" width="560" height="130" as="geometry" />
        </mxCell>

        <mxCell id="practice" value="&lt;b&gt;练习池&lt;/b&gt;：/api/challenge/today?category=X 额外给该类别 4 道（PRACTICE_POOL_SIZE），不占套餐槽位、不参与完成判定。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#6C8EBF;fontSize=11;dashed=1;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="586" width="560" height="52" as="geometry" />
        </mxCell>

