<mxfile host="Electron" modified="2026-09-20T00:00:00.000Z" agent="arena-doc" version="24.0.0" type="device">
  <diagram id="daily-plan" name="05-今日套餐与复习排期">
    <mxGraphModel dx="1180" dy="760" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="今日套餐与复习排期：每天 2 道主栈代码题 + 1 道副栈主观题，到期的错题来顶槽位" style="text;html=1;align=left;fontSize=18;fontStyle=1;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="40" y="14" width="1100" height="28" as="geometry" />
        </mxCell>

        <mxCell id="entry" value="&lt;b&gt;GET /api/challenge/today&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF3FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="56" width="480" height="38" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="settings['plan:YYYY-MM-DD']　命中且仍有效 → 直接返回（同日两次调用 deep-equal）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#1F9E7E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="480" height="44" as="geometry" />
        </mxCell>
        <mxCell id="miss" value="未命中 → 重新选题（下面 4 步）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="172" width="480" height="32" as="geometry" />
        </mxCell>
        <mxCell id="cur" value="&lt;b&gt;1. content/curriculum/&amp;lt;YYYY-MM&amp;gt;.json&lt;/b&gt;　按日期排主/副类别；没排到就按 categoryOrder(date) 轮转" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FBEC;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="222" width="480" height="48" as="geometry" />
        </mxCell>
        <mxCell id="count" value="&lt;b&gt;2. 主栈题量微调（adaptive.ts）&lt;/b&gt;　近 7 天正确率 → 2 / 3 题，reason 记 default | adaptive-low | adaptive-high；上限是该类别现有可判题数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5F1;strokeColor=#1F9E7E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="288" width="480" height="52" as="geometry" />
        </mxCell>
        <mxCell id="pick" value="&lt;b&gt;3. pickForDay(judgeable, date, mainCategory, n)&lt;/b&gt;　以日期为种子的确定性算法（shared/game.ts）；副栈从主观题里取 1 道" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5F1;strokeColor=#1F9E7E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="358" width="480" height="48" as="geometry" />
        </mxCell>
        <mxCell id="review" value="&lt;b&gt;4. 复习顶槽&lt;/b&gt;　loadBook() → dueIds(book, today) → pickReview()：优先&quot;今天主栈类别的代码题&quot; → &quot;副栈的主观题&quot; → 任意代码题 → 任意主观题" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEEF4;strokeColor=#B8547D;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="424" width="480" height="52" as="geometry" />
        </mxCell>
        <mxCell id="slot" value="顶掉&lt;b&gt;同形态那一组&lt;/b&gt;的最后一个槽位 → 槽位总数不变 → 完成判定与 XP 上限都不必改；该题 id 记进 plan.reviewIds，界面上标&quot;复习&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8547D;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="494" width="480" height="52" as="geometry" />
        </mxCell>
        <mxCell id="write" value="写回 settings 缓存 → 返回 { plan, questions, reviewIds, progress }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#1F9E7E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="564" width="480" height="38" as="geometry" />
        </mxCell>

        <mxCell id="bookTitle" value="错题本存在哪（settings['review:book']，不是第二张表）" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="580" y="56" width="560" height="22" as="geometry" />
