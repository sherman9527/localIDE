          <mxGeometry x="480" y="60" width="170" height="470" as="geometry" />
        </mxCell>
        <mxCell id="lfC" value="&lt;b&gt;JudgePort&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;judge/registry.ts&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F7F3FB;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1">
