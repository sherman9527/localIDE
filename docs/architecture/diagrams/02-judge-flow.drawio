        <mxCell id="lfD" value="&lt;b&gt;runner + 沙箱&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;runners/* · workspace.ts · process.ts&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#FFF4E6;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="910" y="60" width="180" height="470" as="geometry" />
        </mxCell>
        <mxCell id="lfE" value="&lt;b&gt;账本 + 游戏&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;db/index.ts · game/review.ts · game/xp.ts&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#E8F5F1;strokeColor=#1F9E7E;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1135" y="60" width="170" height="470" as="geometry" />
        </mxCell>

        <mxCell id="m1" value="1. 提交（Java / TSX / SQL / Redis 命令 / Spark）" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="135" y="122" as="sourcePoint" /><mxPoint x="350" y="122" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m2" value="2. 生成 / 沿用 x-trace-id" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#666666;strokeWidth=2;fontSize=11;exitX=1;exitY=0.15;entryX=1;entryY=0.19;" edge="1" parent="1" source="lfB" target="lfB">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="424" y="150" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="m3" value="3. answerable(id)：题目存在 且 不在 hidden.json" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#82B366;strokeWidth=2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="350" y="180" as="sourcePoint" /><mxPoint x="565" y="180" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m4" value="4. run(req, question, onEvent) —— 只认 JudgePort" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#9673A6;strokeWidth=2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="350" y="208" as="sourcePoint" /><mxPoint x="780" y="208" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m5" value="5. 按 question.judgeKind 派发到具体 runner" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#D79B00;strokeWidth=2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="780" y="236" as="sourcePoint" /><mxPoint x="1000" y="236" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m6" value="6. 写用例 → 编译 → 跑断言" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#D79B00;strokeWidth=2;fontSize=11;exitX=1;exitY=0.38;entryX=1;entryY=0.42;" edge="1" parent="1" source="lfD" target="lfD">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1074" y="266" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="m7" value="7. JudgeResult（逐用例 expected / actual + errorKind）" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#1F9E7E;strokeWidth=2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1000" y="294" as="sourcePoint" /><mxPoint x="780" y="294" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m8" value="8. record(attempt)　·　applyAttempt() 复习排期" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#1F9E7E;strokeWidth=2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="780" y="322" as="sourcePoint" /><mxPoint x="1220" y="322" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="m9" value="9. settleDailySet()：套餐做完则幂等 +10 XP" style="html=1;verticalAlign=bottom;endArrow=block;strokeColor=#1F9E7E;strokeWidth=2;fontSize=11;exitX=1;exitY=0.58;entryX=1;entryY=0.62;" edge="1" parent="1" source="lfE" target="lfE">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1294" y="352" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="m10" value="10. { result, mode, best }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="780" y="382" as="sourcePoint" /><mxPoint x="135" y="382" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="noteWs" value="&lt;b&gt;第 5~6 步之内&lt;/b&gt;：mkdtemp 一个 data/judge/&amp;lt;tag&amp;gt;-XXXX 沙箱；写提交与 harness；&lt;br&gt;超时与输出截断由 process.ts 兜；结果只读 arena-results.json；finally 必删目录" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=#D6B656;fontSize=11;align=left;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="700" y="404" width="420" height="56" as="geometry" />
        </mxCell>
        <mxCell id="noteSelf" value="&lt;b&gt;带 customCases（自测）时&lt;/b&gt;：用请求里的用例替换题目用例，只回反馈——&lt;br&gt;不写 attempt、不给 XP、不影响套餐进度（第 8~9 步整个跳过）" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=#D6B656;fontSize=11;align=left;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="404" width="420" height="56" as="geometry" />
        </mxCell>

        <mxCell id="facts" value="&lt;b&gt;为什么值得信&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;· &lt;b&gt;fail&lt;/b&gt; = 跑起来了但结果不对；&lt;b&gt;error&lt;/b&gt; = 根本没跑到断言（编译失败 / 抛异常 / 超时 / 被白名单拒）。两者永不混，否则会把编译器报错误读成&quot;思路错了&quot;。&lt;br&gt;· 不解析 JUnit XML：DynamicTest 的名字在报告里会变成 judge()[1]，拿不回用例名，所以 harness 自己写 arena-results.json 当唯一事实来源。&lt;br&gt;· 每个 runner 都有&quot;已知正确解必须 pass + 已知错误解必须 fail&quot;的双向测试（server/test/judge/*）；判题矩阵整片 skip 会被 assert-ran.mjs 判为失败。&lt;br&gt;· /api/judge/stream 是同一条链路的 SSE 形态：queued → log* → result，5s 一条 keep-alive；参数错误必须在 hijack 之前用 JSON 返回。&lt;br&gt;· traceId 贯穿 HTTP → 判题 → 评分：npm run logs -- --trace &amp;lt;id&amp;gt; 一把捞出整条链路。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="486" width="1140" height="140" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
