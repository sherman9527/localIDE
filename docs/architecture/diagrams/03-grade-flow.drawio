<mxfile host="Electron" modified="2026-09-20T00:00:00.000Z" agent="arena-doc" version="24.0.0" type="device">
  <diagram id="grade-flow" name="03-主观题评分与降级链">
    <mxGraphModel dx="1100" dy="760" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="主观题评分：provider 逐档降级，任何一档失败都不许变成 500" style="text;html=1;align=left;fontSize=18;fontStyle=1;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="40" y="14" width="1000" height="28" as="geometry" />
        </mxCell>

        <mxCell id="entry" value="&lt;b&gt;POST /api/grade&lt;/b&gt;　questionId + answer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF3FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="56" width="480" height="40" as="geometry" />
        </mxCell>
        <mxCell id="check" value="answerable(id)：存在 且 未被软删除" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FBEC;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="480" height="36" as="geometry" />
        </mxCell>
        <mxCell id="grade" value="&lt;b&gt;GradePort.grade(question, answer, traceId)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;llm/rubric.ts · createGrader(resolveProviders(config.llm.providers))&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEEF4;strokeColor=#B8547D;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="480" height="50" as="geometry" />
        </mxCell>

        <mxCell id="chainLabel" value="按 config.llm.providers 顺序尝试，默认 bridge → qodercli → copilot → manual" style="text;html=1;align=left;fontSize=11;fontStyle=2;fontColor=#B8547D;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="500" height="20" as="geometry" />
        </mxCell>
        <mxCell id="pBridge" value="&lt;b&gt;① bridge&lt;/b&gt;　HTTP 到宿主 :7799（带 x-arena-token）&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#595959&quot;&gt;scripts/llm-bridge.mjs 代跑宿主已登录 CLI —— 容器是 linux，进不去 qodercli.exe&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8547D;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="244" width="480" height="58" as="geometry" />
        </mxCell>
        <mxCell id="pQoder" value="&lt;b&gt;② qodercli&lt;/b&gt;　容器内直接 spawn 本机 CLI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8547D;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="322" width="480" height="36" as="geometry" />
        </mxCell>
        <mxCell id="pCopilot" value="&lt;b&gt;③ copilot&lt;/b&gt;　容器内直接 spawn 本机 CLI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8547D;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="378" width="480" height="36" as="geometry" />
        </mxCell>
        <mxCell id="pManual" value="&lt;b&gt;④ manual&lt;/b&gt;　返回人工自检表（rubric 逐项列出，自己勾）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#B8547D;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="434" width="480" height="40" as="geometry" />
        </mxCell>

        <mxCell id="eEntryCheck" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6C8EBF;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="entry" target="check"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eCheckGrade" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82B366;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="check" target="grade"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eGradeBridge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B8547D;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="grade" target="pBridge"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eF1" value="不可用 / 超时 / 返回非 JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B8547D;strokeWidth=1;dashed=1;fontSize=10;fontColor=#B8547D;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pBridge" target="pQoder"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eF2" value="失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B8547D;strokeWidth=1;dashed=1;fontSize=10;fontColor=#B8547D;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pQoder" target="pCopilot"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eF3" value="失败" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B8547D;strokeWidth=1;dashed=1;fontSize=10;fontColor=#B8547D;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pCopilot" target="pManual"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="normTitle" value="拿到模型输出之后（rubric.ts 归一）" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="640" y="220" width="460" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="剥 code fence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8547D;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="248" width="460" height="38" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="取第一个平衡 JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8547D;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="302" width="460" height="38" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="zod 校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8547D;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="356" width="460" height="38" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="clamp 到 maxScore" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8547D;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="410" width="460" height="38" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="按 rubric 逐项归一：hit / earned / nextStep" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8547D;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="464" width="460" height="38" as="geometry" />
        </mxCell>
        <mxCell id="verdict" value="&lt;b&gt;RubricVerdict&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEEF4;strokeColor=#B8547D;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="518" width="460" height="38" as="geometry" />
        </mxCell>
        <mxCell id="en1" style="html=1;strokeColor=#B8547D;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="en2" style="html=1;strokeColor=#B8547D;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="en3" style="html=1;strokeColor=#B8547D;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="en4" style="html=1;strokeColor=#B8547D;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="en5" style="html=1;strokeColor=#B8547D;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n5" target="verdict"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="eBridgeNorm" value="模型输出" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B8547D;strokeWidth=2;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pBridge" target="n1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="record" value="&lt;b&gt;记账&lt;/b&gt;：kind='grade' 的 attempt　·　XP = round(score / maxScore × 20)　·　&amp;ge; 60% 记 pass　·　写复习排期" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5F1;strokeColor=#1F9E7E;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="1040" height="44" as="geometry" />
        </mxCell>
        <mxCell id="eVerdictRecord" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F9E7E;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="verdict" target="record"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eManualRecord" value="自检表也记账，只是不给模型分" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#999999;strokeWidth=2;dashed=1;fontSize=11;fontColor=#595959;exitX=0.5;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="pManual" target="record"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="facts" value="&lt;b&gt;三条纪律&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;· &lt;b&gt;降级绝不静默&lt;/b&gt;：每一档没用都写一条 grade/fallback（warn，带 traceId 与原因），结论写 grade/done。想查&quot;为什么给的是自检表&quot;：npm run logs -- --module grade --level warn&lt;br&gt;· &lt;b&gt;/api/health 的 llm-rubric 探的是 GradePort.available()&lt;/b&gt;，不是判题 runner 注册表 —— 主观题没有 runner，按注册表探必然 false；manual 不算可用，它只是自检表。&lt;br&gt;· &lt;b&gt;token 以 .env 为唯一来源&lt;/b&gt;：宿主桥与容器必须同一个 token，不一致会让 /complete 全 401 → 评分静默掉到 manual（踩过，故 start.sh 会主动重启旧桥）。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="672" width="1040" height="104" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
