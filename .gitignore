node_modules/
dist/
coverage/
*.tsbuildinfo
.DS_Store
Thumbs.db

# 运行期数据（SQLite / 判题工作区 / 日志）—— 全部留在仓库内，不写到仓库外目录
data/
*.log

# E2E 产物
test-results/
playwright-report/
blob-report/

# 本地覆盖
.env
.env.local
*.local
# start.sh / start.ps1 改写 .env 用的中间文件（tmp+mv 才有"原文件不被截断"这条保证）。
# 只在失败时留下（成功的 mv 会带走它），而里面就是那份 token —— 不挡住的话一次 mv 失败
# 就把一个带密钥的未跟踪文件摆在那里，等着下一次 `git add -A` 把它提交上去。
.env.tmp.*
.qoder/settings.local.json

# 题库计数的本机辅助文件（check-bank 的基线取 git 已跟踪题数，不依赖它）
.bank-count

# 浏览器自动化产生的临时页面快照
.playwright-mcp/

# npm 缓存里的噪音：每次 npm 动一下就写的调试日志与"上次检查更新"时间戳
# （docker-cache 本体是要留的 —— 它承载离线构建的包，这两类文件不是）
docker-cache/npm/_logs/
docker-cache/npm/_update-notifier-last-checked

# Python 编译缓存（spark_worker 的 .pyc 曾被提交进仓库）
__pycache__/
*.pyc
