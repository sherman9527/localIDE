#!/usr/bin/env bash
# 提交前快检：lint + 类型 + 宿主机能跑的单元测试。
# 判题套件与 E2E 需要容器里的 JDK/MySQL/Redis/Spark，因此这里跳过（发布前必须容器内补跑）：
#   docker compose run --rm arena npm run verify
# 紧急绕过：ARENA_SKIP_HOOK=1 git commit ...（请在 memo.md 说明原因）
set -uo pipefail
# 不能用 `dirname $0/..` 推仓库根：core.hooksPath 指向 .githooks 时它算对，
# 但把本文件复制进 .git/hooks 时会算成 .git —— 于是 scripts/verify.sh 直接找不到。
root="$(git rev-parse --show-toplevel)" || exit 1
cd "${root}"

# 署名闸门排在"跳过校验"那条早退**之前**：ARENA_SKIP_HOOK 绕的是测试套件，
# 不该顺手绕掉发布纪律 —— 提交身份推上去就公开了，收不回来。
if ! bash .githooks/check-commit-identity.sh; then
  echo '[pre-commit] 署名闸门未通过，提交已阻止（改法见上一条输出）。' >&2
  exit 1
fi

# 生效的到底是哪份 hook：core.hooksPath 没指过来时，git 跑的是 .git/hooks/pre-commit 那份拷贝。
# 改了 .githooks 而拷贝没跟上，闸门会"看起来还在守着"其实停在旧行为上。
active_hook="$(git rev-parse --git-path hooks/pre-commit 2>/dev/null || echo '')"
if [ -n "${active_hook}" ] && [ -f "${active_hook}" ] && ! cmp -s "${active_hook}" "${root}/.githooks/pre-commit"; then
  echo "[pre-commit] 注意：当前生效的 hook 与 .githooks/pre-commit 不一致，请同步：cp .githooks/pre-commit \"${active_hook}\"（或 npm run hooks:install）" >&2
fi

if [ "${ARENA_SKIP_HOOK:-0}" = "1" ]; then
  echo '[pre-commit] 已跳过（ARENA_SKIP_HOOK=1）—— 请记得在 memo.md 记录原因' >&2
  exit 0
fi

bash scripts/verify.sh --fast
status=$?

if [ $status -ne 0 ]; then
  echo '[pre-commit] 校验未通过，提交已阻止。修完再提交，或按 rule.md 说明后跳过。' >&2
  exit $status
fi
