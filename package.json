{
  "name": "daily-interview-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web",
    "tests"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w web",
    "start": "node server/dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b shared server web && npm run typecheck:tests",
    "typecheck:tests": "tsc -p shared/tsconfig.test.json && tsc -p server/tsconfig.test.json && tsc -p tests/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "e2e": "playwright test -c tests/playwright.config.ts",
    "verify": "bash scripts/verify.sh",
    "verify:fast": "bash scripts/verify.sh --fast",
    "hooks:install": "git config core.hooksPath .githooks",
    "bank:check": "node scripts/check-bank.mjs",
    "bank:add": "node scripts/bank/add-questions.mjs",
    "logs": "node scripts/tail-logs.mjs",
    "bank:refresh": "node scripts/jd/refresh-bank.mjs",
    "bank:generate": "node scripts/bank/generate-with-cli.mjs",
    "kb:index": "node scripts/kb/compile-knowledge.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
